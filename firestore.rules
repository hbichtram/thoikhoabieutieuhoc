rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read and write their own teachers document and subcollections
    match /teachers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /timetableVersions/{versionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow users to read and write their own weekly schedules
    match /weeklySchedules/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their own timetable data
    match /timetable_data/{docId} {
      allow read, write: if request.auth != null && (docId == request.auth.uid || docId.matches('^' + request.auth.uid + '_.*'));
    }

    // Default deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
