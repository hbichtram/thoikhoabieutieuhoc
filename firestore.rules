rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct, independent identification of System Admin by UID or Email
    // Does NOT depend on users/{uid} document existing!
    function isSystemAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'CDDP2wg0tWb1E01arXBouCfd4ZP2' ||
        ('email' in request.auth.token && (
          request.auth.token.email == 'tram.ai.ctst@gmail.com' ||
          request.auth.token.email.lower() == 'tram.ai.ctst@gmail.com'
        )) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        )
      );
    }

    function isActiveManager() {
      return isAuthenticated() && !isSystemAdmin() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isManagerOfSchool(schoolId) {
      return isActiveManager() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // 1. Authorized Users Collection: authorized_users/{emailKey}
    match /authorized_users/{emailKey} {
      // System Admin has full permissions (create, read, update, delete)
      allow read, write: if isSystemAdmin();

      // Regular user can ONLY get/read their own pre-authorization document matching their Google Auth token email
      allow get: if isAuthenticated() && request.auth.token.email != null && (
        emailKey == request.auth.token.email.lower() ||
        (resource != null && 'email' in resource.data && resource.data.email.lower() == request.auth.token.email.lower())
      );

      // Deny collection-level listing for regular users (prevents email harvesting)
      allow list: if isSystemAdmin();
    }

    // 2. User Profiles Collection: users/{userId}
    match /users/{userId} {
      // System Admin has full permissions (create, read, update, delete)
      allow read, create, update, delete: if isSystemAdmin();

      // Regular user can read their own profile by UID or by pre-registered matching email
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && 'email' in resource.data && resource.data.email.lower() == request.auth.token.email.lower())
      );
      allow list: if isAuthenticated() && request.auth.token.email != null;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Schools Collection: schools/{schoolId}
    match /schools/{schoolId} {
      // System Admin has full permissions (create, read, update, delete)
      allow create, delete: if isSystemAdmin();
      allow read: if isSystemAdmin() || isManagerOfSchool(schoolId);
      allow update: if isSystemAdmin() || isManagerOfSchool(schoolId);

      // Timetable data subcollection: schools/{schoolId}/timetable_data/{docId}
      match /timetable_data/{docId} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }

      // Versions subcollection: schools/{schoolId}/versions/{versionId}
      match /versions/{versionId} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }

      // Any other subcollections under school
      match /{allSubcollections=**} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }
    }

    // 3. Legacy compatibility paths for individual users
    match /timetable_data/{docId} {
      allow read, create, update, delete: if isAuthenticated() && (
        docId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    match /teachers/{userId} {
      allow read, create, update, delete: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());

      match /{allSubcollections=**} {
        allow read, create, update, delete: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
      }
    }

    match /weeklySchedules/{userId} {
      allow read, create, update, delete: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
