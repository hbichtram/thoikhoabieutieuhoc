rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct, independent identification of System Admin by UID or Email
    // Does NOT depend on users/{uid} document existing!
    function isHardcodedAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'CDDP2wg0tWb1E01arXBouCfd4ZP2' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'tram.ai.ctst@gmail.com' ||
          request.auth.token.email.lower() == 'tram.ai.ctst@gmail.com'
        ))
      );
    }

    function hasValidUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isDbAdmin() {
      return hasValidUserDoc() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSystemAdmin() {
      return isHardcodedAdmin() || isDbAdmin();
    }

    function isActiveManager() {
      return isAuthenticated() && !isSystemAdmin() && 
        hasValidUserDoc() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isManagerOfSchool(schoolId) {
      return isActiveManager() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // 1. User Profiles Collection: users/{userId}
    match /users/{userId} {
      // User can read their own profile, Admin can read all user profiles
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isSystemAdmin()
      );
      
      // Admin can create any user profile (e.g. pre-registering managers). User can create their own profile.
      allow create: if isAuthenticated() && (
        isSystemAdmin() || 
        request.auth.uid == userId
      );

      // Admin can update any profile (role, status, schoolId).
      // Regular user can only update their non-sensitive profile fields.
      allow update: if isAuthenticated() && (
        isSystemAdmin() || (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
          (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
          (!('schoolId' in request.resource.data) || request.resource.data.schoolId == resource.data.schoolId)
        )
      );

      // Only Admin can delete user profiles
      allow delete: if isSystemAdmin();
    }

    // 2. Schools Collection: schools/{schoolId}
    match /schools/{schoolId} {
      // Admin can read all schools. Manager can only read their own school.
      allow read: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
      // Admin can manage all schools. Manager can update their own school details.
      allow create, delete: if isAuthenticated() && isSystemAdmin();
      allow update: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));

      // Timetable data subcollection: schools/{schoolId}/timetable_data/{docId}
      match /timetable_data/{docId} {
        allow read: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
        allow create, update, delete: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
      }

      // Versions subcollection: schools/{schoolId}/versions/{versionId}
      match /versions/{versionId} {
        allow read: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
        allow create, update, delete: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
      }

      // Any other subcollections under school
      match /{allSubcollections=**} {
        allow read: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
        allow create, update, delete: if isAuthenticated() && (isSystemAdmin() || isManagerOfSchool(schoolId));
      }
    }

    // 3. Legacy compatibility paths for individual users
    match /timetable_data/{docId} {
      allow read, write: if isAuthenticated() && (
        docId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    match /teachers/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
      }
    }

    match /weeklySchedules/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
