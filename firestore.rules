rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct, independent identification of System Admin by UID or Email
    // Does NOT depend on users/{uid} document existing!
    function isHardcodedAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'CDDP2wg0tWb1E01arXBouCfd4ZP2' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'tram.ai.ctst@gmail.com' ||
          request.auth.token.email.lower() == 'tram.ai.ctst@gmail.com'
        ))
      );
    }

    function isDbAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isSystemAdmin() {
      return isHardcodedAdmin() || isDbAdmin();
    }

    function isActiveManager() {
      return isAuthenticated() && !isSystemAdmin() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager' && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isManagerOfSchool(schoolId) {
      return isActiveManager() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // 1. User Profiles Collection: users/{userId}
    match /users/{userId} {
      // System Admin has full read and write permissions (create, read, update, delete)
      allow read, write: if isSystemAdmin();

      // Regular user can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Regular user can create their own initial profile
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Regular user can update their own non-sensitive profile fields
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) &&
        (!('schoolId' in request.resource.data) || request.resource.data.schoolId == resource.data.schoolId);
    }

    // 2. Schools Collection: schools/{schoolId}
    match /schools/{schoolId} {
      // System Admin has full read and write permissions (create, read, update, delete)
      allow read, write: if isSystemAdmin();

      // Active Manager of this school can read their own school
      allow read: if isManagerOfSchool(schoolId);

      // Active Manager of this school can update their own school details
      allow update: if isManagerOfSchool(schoolId);

      // Timetable data subcollection: schools/{schoolId}/timetable_data/{docId}
      match /timetable_data/{docId} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }

      // Versions subcollection: schools/{schoolId}/versions/{versionId}
      match /versions/{versionId} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }

      // Any other subcollections under school
      match /{allSubcollections=**} {
        allow read, write: if isSystemAdmin() || isManagerOfSchool(schoolId);
      }
    }

    // 3. Legacy compatibility paths for individual users
    match /timetable_data/{docId} {
      allow read, write: if isAuthenticated() && (
        docId == request.auth.uid ||
        isSystemAdmin()
      );
    }

    match /teachers/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());

      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
      }
    }

    match /weeklySchedules/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isSystemAdmin());
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
